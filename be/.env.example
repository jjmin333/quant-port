# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080

# Database — MYSQL_DSN 으로 연결 (호스트/IP·계정만 환경별 변경)
# loc은 MySQL 서버가 실제로 시간을 저장하는 타임존과 일치해야 함(대개 호스트 OS 타임존).
# 컨테이너 자체 TZ(대개 UTC)에 좌우되지 않도록 Local 대신 Asia/Seoul을 명시.
# 예: quantport:secret@tcp(db.example.com:3306)/quantport?parseTime=true&charset=utf8mb4&loc=Asia%2FSeoul
MYSQL_DSN=quantport:quantport@tcp(localhost:3306)/quantport?parseTime=true&charset=utf8mb4&loc=Asia%2FSeoul
# 커넥션 풀 (미설정 시 50 / 25). DB의 max_connections 가 낮으면 줄여서 설정
# MYSQL_MAX_OPEN_CONNS=50

# 세션 타임존. 코드가 DSN에 time_zone='+09:00' 을 자동으로 넣는다(미설정 시).
# **서버 기본값에 기대지 않는 이유**: loc=Asia/Seoul 은 "서버가 KST 벽시계로
# 말한다"는 전제인데, 관리형 MySQL은 대개 UTC다. 그대로 옮기면 TIMESTAMP 컬럼
# (이 스키마에 85개)을 읽는 값이 9시간 밀리고, SQL 안의 NOW()가 KST로 저장된
# DATETIME(candle_bars.bar_time 등)과 어긋난다.
# 서머타임이 없어 오프셋 고정이 무손실이다. DSN에 직접 적으면 그쪽이 이긴다.
# MYSQL_TIME_ZONE=+09:00

# 기동 시 스키마 마이그레이션 전체에 걸리는 마감(기본 60초).
# 큰 표를 건드리는 마이그레이션이 있는 배포에서만 올린다 — 여기서 잘리면
# api가 기동에 실패하고 워커도 함께 못 뜬다. 대형 ALTER는 배포에 섞지 말 것.
# SCHEMA_MIGRATION_TIMEOUT_SECONDS=60
# MYSQL_MAX_IDLE_CONNS=25

# Cache
REDIS_URL=redis://localhost:6379/0

# Frontend CORS — 브라우저 Origin(스킴+호스트+포트). 도메인 배포 시 https://your.domain 추가.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://quant-port.com,http://quant-port.com

# Auth (required)
# Generate: openssl rand -base64 32
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false

# Toss Securities Open API (OAuth client_credentials) — market data only
# (quotes, candles, rankings, warnings). Per-user account linking is removed.
# OpenAPI spec: docs/toss-openapi.json
#
# Two OAuth apps, same permissions. PRIMARY is used for every call. When a
# rate-limit group on PRIMARY is exhausted (429, or remaining ≤ 20%), that
# group switches to SECONDARY until Toss's reset window, then back to PRIMARY.
# Groups (MARKET_DATA, MARKET_DATA_CHART, STOCK, …) fail over independently.
# TOSS_CLIENT_ID / TOSS_CLIENT_SECRET still work as PRIMARY aliases.
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_PRIMARY_CLIENT_ID=your_primary_client_id
TOSS_PRIMARY_CLIENT_SECRET=your_primary_client_secret
TOSS_SECONDARY_CLIENT_ID=your_secondary_client_id
TOSS_SECONDARY_CLIENT_SECRET=your_secondary_client_secret

# 실시간 시세 구독(웹소켓). 기본 off — 켜면 차트·호가 화면의 호가·체결이 REST
# 폴링이 아니라 푸시로 오고, 그 화면의 Toss REST 호출이 사실상 0이 된다
# (실측: 시청자 1명 30초 기준 57회 → 3회).
#
# **위 두 자격증명을 REST와 함께 쓴다.** 전용 앱이 필요하지 않다 — 연결을 닫아도
# 토큰이 죽지 않는다는 것을 실측으로 확인했고(docs/TOSS_TOKEN_DESIGN.md),
# 재연결이 토큰을 재발급하지 않도록 코드가 강제한다.
#
# 끄면 즉시 예전 폴링 동작으로 돌아간다.
TOSS_STREAM_ENABLED=false

# AI briefing / 종목 AI 요약 (OpenAI-compatible).
# Leave OPENAI_* empty and set Gemini keys to use Gemini's OpenAI-compatible
# endpoint — see config.buildLLMConfig.
#
# LLM spend is split by market. New LLM features must keep this split
# (llm.Pool.For(market)) rather than billing one shared key.
#   국내: 종목 AI 요약 + 국내 뉴스 브리핑  → GEMINI_KR_API_KEY
#   해외: 종목 AI 요약 + 해외 뉴스 브리핑  → GEMINI_US_API_KEY
# GEMINI_API_KEY is a fallback when a regional key is unset. Identical keys
# share one quota bucket (legacy).
OPENAI_API_KEY=
OPENAI_KR_API_KEY=
OPENAI_US_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GEMINI_KR_API_KEY=
GEMINI_US_API_KEY=
GEMINI_API_KEY=

# Provider quota ceilings the AI 요약 batch sizes itself against. Empty keeps
# the compiled-in defaults (Gemini free tier: 500 RPD / 15 RPM / 250K TPM,
# plus a self-imposed 1M tokens/day). Set these to whatever your provider
# console actually reports. A negative value removes that ceiling.
LLM_DAILY_QUOTA=
LLM_PER_MINUTE=
LLM_TOKENS_PER_MINUTE=
LLM_TOKENS_PER_DAY=

# DART Open API — 국내 공시 (https://opendart.fss.or.kr)
DART_API_KEY=

# SEC EDGAR — 미국 XBRL (User-Agent 필수, 예: "QuantPort admin@example.com")
SEC_EDGAR_USER_AGENT=

# Finnhub — US quotes & earnings (https://finnhub.io)
FINNHUB_API_KEY=

# Finnhub — US news ingest only (separate free-tier key; optional — RSS-only when empty)
FINNHUB_NEWS_API_KEY=

# FnGuide — 국내 실적발표 캘린더 (잠정실적 발표일 + 컨센서스·발표치).
#
# API 키가 없다. 공개 API가 아니라 Company Guide 화면(wcomp.fnguide.com)이 쓰는
# 내부 JSON을 읽는다 — 예고 없이 바뀔 수 있고, 약관과의 관계는 프로젝트가 알고
# 감수한 선택이다. FNGUIDE_ENABLED=false로 코드 배포 없이 즉시 끌 수 있다
# (끄면 국내 실적 화면은 DART 공시 이력으로 되돌아가고, 화면은 계속 뜬다).
FNGUIDE_ENABLED=true
FNGUIDE_BASE_URL=https://wcomp.fnguide.com

# KRX Open API — domestic ETF/ETN catalog (https://openapi.krx.co.kr)
# KRX_API_KEY or KRX_OPEN_API_KEY (portal name)
KRX_API_KEY=

# FRED — US indices & macro (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# goldprice.dev — gold spot (https://goldprice.dev)
GOLDPRICE_API_KEY=

# Upbit — crypto quotation (public ticker works without keys; store for future private API)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Naver API HUB — domestic news search (NCP console)
# https://guide.ncloud-docs.com/docs/apihub-migration
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# 해외 뉴스 제목 EN→KO — **Azure AI Translator** (2026-09-11 전환).
#
# 포털 > Translator 리소스 > Keys and Endpoint 에서:
#   KEY        → AZURE_TRANSLATOR_KEY
#   Location   → AZURE_TRANSLATOR_REGION (예: koreacentral). 전역 리소스면 비워 둔다.
#   ENDPOINT   → 기본값(https://api.cognitive.microsofttranslator.com)과 다를 때만 적는다.
#
# **키가 없으면 번역 엔진이 아예 안 붙는다** — 해외 제목은 영어로 남고 기동 로그가
# 그 사실을 찍는다. 조용히 자체 모델로 떨어지지 않는다(그 컨테이너는 기본 기동에서
# 빠졌다 — docker-compose.yml 의 legacy-translator 프로파일).
#
# 한도는 무료 등급(F0) 기준 **월 200만 자**이고, apibudget이 보낸 원문 문자 수를
# 세어 그 한도에서 막는다(azure_translate 버킷). 넘긴 제목은 영어로 남는다.
# 포털의 KEY 1 / KEY 2 이름 그대로 적어도 읽는다
#   (AZURE_TRANSLATOR_API_KEY_FIRST / _SECOND).
AZURE_TRANSLATOR_KEY=
# 지역이 틀리면 401001이 오고 번역이 전부 빈 결과가 된다.
AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=
#
# 되돌리기(자체 모델): TRANSLATE_PROVIDER=local + compose 의 legacy-translator 프로파일.
# Papago(NCP)는 2026-09-03에 걷어냈다: 자격증명이 만료됐고 갱신하지 않는다.
# 자체 모델의 근거와 선정 과정은 docs/TRANSLATION_SELFHOST.md.
# TRANSLATE_PROVIDER=azure
# TRANSLATE_LOCAL_URL=http://translator:8100

# Kakao REST API — domestic news search (https://developers.kakao.com)
KAKAO_REST_API_KEY=

# Screenshot import (Tesseract OCR temp files)
# Local dev (be/ cwd): tmp/import
# Docker Compose api: /var/lib/quant-port/import (tmpfs, job 완료 후 삭제)
IMPORT_TEMP_DIR=tmp/import

# 동시에 도는 tesseract 프로세스 수. 미설정 시 GOMAXPROCS(= 컨테이너가 쓸 수 있는
# 코어 수)를 쓴다. 0 이면 상한 해제(롤백용).
#
# 잡당 이미지 상한은 10장인데(maxImportImages), 그 10장이 동시에 tesseract를
# 최대 10패스씩 돌리면 2 OCPU 박스를 사용자 한 명이 통째로 가져간다. OCR이 도는
# 동안 같은 프로세스의 API 응답과 시세 폴러가 함께 밀린다.
# OCR_MAX_CONCURRENCY=2

# 사용자 업로드 이미지(리포트 본문 등) — import temp와 달리 영구 보관이다.
# Local dev (be/ cwd): var/media · Docker Compose api: /var/lib/quant-port/media (named volume)
MEDIA_DIR=var/media
# 파일 1개 상한(MB)
MEDIA_MAX_UPLOAD_MB=5
# CDN/객체 스토리지 앞단이 생기면 그 base URL. 비어 있으면 API가 /api/v1/media/<key>로 직접 서빙
MEDIA_PUBLIC_BASE_URL=

# Migrated stock logos manifest (default: ../fe/public/logos/manifest.json from be/)
# LOGO_MANIFEST_PATH=

# --- Rate limit -------------------------------------------------------------
# 로그인 사용자는 user_id, 비로그인은 IP 기준. 근거·트레이드오프는
# internal/middleware/ratelimit.go 주석 참조.
# 임계값을 잘못 잡아 정상 사용자가 429를 맞으면 RATE_LIMIT_ENABLED=false로 즉시 끈다.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_RPS=20
RATE_LIMIT_USER_BURST=40
RATE_LIMIT_IP_RPS=30
RATE_LIMIT_IP_BURST=60

# 리버스 프록시(nginx/ALB/Next rewrite) 뒤에 있으면 true. X-Forwarded-For는
# **loopback/사설 대역 peer에서 온 것만** 신뢰하고 오른쪽 hop부터 읽는다.
# 프록시 없이 앱을 직접 노출하면 false로 두어 헤더를 아예 무시한다.
TRUST_PROXY_HEADERS=true

# 요청 하나가 붙잡을 수 있는 시간의 상한(초). 0이면 끈다.
# WriteTimeout은 응답을 쓰기 시작해야 적용돼 멈춘 핸들러를 못 막는다 —
# Redis 정지 시 /quotes/{symbol}이 120초를 넘겨도 응답하지 않았다.
# SSE·업로드·관리자 경로는 제외된다(internal/middleware/timeout.go).
REQUEST_TIMEOUT_SECONDS=10

# Redis 메모리 상한. 클라우드에서는 인스턴스 RAM의 60~70%로 잡는다.
REDIS_MAXMEMORY=1gb

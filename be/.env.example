# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080

# Database — MYSQL_DSN 으로 연결 (호스트/IP·계정만 환경별 변경)
# 예: quantport:secret@tcp(db.example.com:3306)/quantport?parseTime=true&charset=utf8mb4&loc=Local
MYSQL_DSN=quantport:quantport@tcp(localhost:3306)/quantport?parseTime=true&charset=utf8mb4&loc=Local

# Cache
REDIS_URL=redis://localhost:6379/0

# Frontend CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth (required)
# Generate: openssl rand -base64 32
JWT_SECRET=change_me_to_a_long_random_secret
ENCRYPTION_MASTER_KEY=change_me_to_base64_32_bytes
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
# Dev fallback: use global TOSS_CLIENT_ID/SECRET when user has not linked broker
AUTH_ALLOW_GLOBAL_TOSS=true

# Toss Securities Open API (OAuth client_credentials)
# OpenAPI spec: docs/toss-openapi.json
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_ID=your_client_id
TOSS_CLIENT_SECRET=your_client_secret

# AI briefing (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DART Open API — 국내 공시 (https://opendart.fss.or.kr)
DART_API_KEY=

# SEC EDGAR — 미국 XBRL (User-Agent 필수, 예: "QuantPort admin@example.com")
SEC_EDGAR_USER_AGENT=

# Finnhub — US quotes & earnings (https://finnhub.io)
FINNHUB_API_KEY=

# FRED — US indices & macro (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# goldprice.dev — gold spot (https://goldprice.dev)
GOLDPRICE_API_KEY=

# Upbit — crypto quotation (public ticker works without keys; store for future private API)
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Naver API HUB — domestic news (NCP console, not developers.naver.com)
# https://guide.ncloud-docs.com/docs/apihub-migration
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao REST API — domestic news search (https://developers.kakao.com)
KAKAO_REST_API_KEY=

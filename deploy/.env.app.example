# API/FE VM 용 compose 변수. `deploy/.env.app` 으로 복사해서 채운다.
#
# 이 파일은 **compose 의 변수 치환**에만 쓰인다(컨테이너 환경변수는 be/.env).
# app-stack.sh 가 --env-file 로 넘긴다.

# ── DB ───────────────────────────────────────────────────────────────────
# 관리형 MySQL 의 사설 엔드포인트. 코드가 세션 타임존을 +09:00 으로 못박으므로
# (repository.withDefaultDSNTimeouts) 서버 기본값이 UTC 여도 안전하다.
# TLS: 우선 tls=preferred 로 시작하고, 커스텀 CA 를 등록한 뒤 tls=custom 으로 올린다.
# require_secure_transport 가 ON 이면 평문 접속은 **전부 실패**하므로 먼저 확인할 것.
MYSQL_DSN=quantport:CHANGE_ME@tcp(10.0.2.10:3306)/quantport?parseTime=true&charset=utf8mb4&loc=Asia%2FSeoul&tls=preferred

# ── Redis ────────────────────────────────────────────────────────────────
# 배치를 다른 VM 에서 돌린다면 이 VM 의 **사설 IP** 로 연다(0.0.0.0 아님).
# 배치도 같은 VM 이면 127.0.0.1 로 두면 된다.
REDIS_BIND=127.0.0.1
# 사설망에 여는 순간 필수. NSG 는 방어의 한 겹일 뿐이다.
REDIS_PASSWORD=CHANGE_ME_long_random
# 컨테이너들이 쓸 Redis URL. 위 비밀번호와 반드시 일치해야 한다.
REDIS_URL_CONTAINER=redis://:CHANGE_ME_long_random@redis:6379/0
# 실측 사용량 42.8 MiB. 컨테이너 메모리 상한(768M)보다 작아야 Redis 가 자기 정책으로
# 축출하기 전에 OOM 킬을 당하지 않는다.
REDIS_MAXMEMORY=512mb

# ── 애플리케이션 ─────────────────────────────────────────────────────────
# 동시에 도는 tesseract 수. 비우면 GOMAXPROCS(= 컨테이너 코어 수)를 쓴다.
# 0 이면 상한 해제(롤백용).
OCR_MAX_CONCURRENCY=

# 큰 마이그레이션이 있는 배포에서만 올린다. 평소엔 비워 둔다(기본 60초).
# 대형 ALTER 는 배포에 섞지 말고 따로 도는 것이 원칙이다.
# SCHEMA_MIGRATION_TIMEOUT_SECONDS=300

# 배치 VM 용 compose 변수. `deploy/.env.batch` 로 복사해서 채운다.
# batch-stack.sh 가 --env-file 로 넘긴다.

# ── DB ───────────────────────────────────────────────────────────────────
# API VM 과 **같은** 관리형 MySQL. 커넥션 예산도 함께 쓴다(api 24 + 워커 8×4 = 56).
MYSQL_DSN=quantport:CHANGE_ME@tcp(10.0.2.10:3306)/quantport?parseTime=true&charset=utf8mb4&loc=Asia%2FSeoul&tls=preferred

# ── Redis — 반드시 API VM 의 것 ──────────────────────────────────────────
# 자체 Redis 를 띄우면 안 된다. 세 가지가 API 프로세스와 공유돼야 한다:
#   1. Toss 토큰 스토어 — client_id 당 활성 토큰이 하나다. 나뉘면 서로의 토큰을
#      401 로 만들고 시세 적재가 끊긴다(실제로 겪은 사고).
#   2. apibudget      — 외부 API 사용량 카운터. 나뉘면 한도를 두 배로 쓴다.
#   3. 지수 스냅샷    — API 폴러가 쓴 것을 워커가 읽는다.
# 값은 API VM 의 사설 IP + REDIS_PASSWORD.
REDIS_URL_CONTAINER=redis://:CHANGE_ME_long_random@10.0.1.5:6379/0

# ── 선택 ─────────────────────────────────────────────────────────────────
# 컨테이너 이름 접두사(기본 quant-port). 배치 VM 에서는 기본값 그대로 둔다 —
# 한 대에서 API 스택과 함께 검증할 때만 바꾼다(이름 충돌 방지).
# CONTAINER_PREFIX=quant-port

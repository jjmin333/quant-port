{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fe-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "fe", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "fe-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "fe", "next", "start", "fe", "-p", "3200"],
      "port": 3200,
      "autoPort": true
    }
  ]
}

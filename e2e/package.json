{
  "name": "quant-port-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "quant-port API 계층 테스트 + 브라우저가 반드시 필요한 시나리오의 E2E",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
